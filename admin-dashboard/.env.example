# URL of the backend server. Every API request, image/video upload and the
# realtime (socket.io) connection from this dashboard goes straight to this
# server — there is no proxy, so it works from any host the dashboard is
# opened on.
#
# Put only the server's base URL here, without a trailing /api:
#   local dev:    http://localhost:5000
#   production:   https://api.example.com
#
# Vite reads env variables when the dev server starts / at build time, so
# restart `npm run dev` (or re-run `npm run build`) after changing this.
VITE_API_URL=http://localhost:5000
