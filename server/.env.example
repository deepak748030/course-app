# Copy to .env and adjust.

# HTTP port the API listens on. The admin dashboard proxies /api here.
PORT=5000

# MongoDB connection string. Point it at any MongoDB 5+ instance.
MONGODB_URI=mongodb://127.0.0.1:27017/ydu-academy

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid (jsonwebtoken syntax: 7d, 12h, 30m...).
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins, or * for any (dev only).
CORS_ORIGIN=*

# development | production
NODE_ENV=development

# Phone sign-in (OTP). Outside production, this fixed code is accepted for any mobile number
# so the demo works without an SMS provider. Ignored when NODE_ENV=production.
DEMO_OTP=246810

# Sign-in SMS. Without a provider, development prints codes to the console and production answers
# code requests with 503 — so set one before launch. Indian SMS must use a DLT-approved template, e.g.
#   "Your YDU Academy sign-in code is {#var#}. It is valid for 5 minutes. Do not share it with anyone."
# SMS_PROVIDER: msg91 | 2factor | fast2sms
SMS_PROVIDER=
# MSG91 (control.msg91.com): Auth key + the ID of an OTP template (its ##OTP## is filled in).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# 2Factor (2factor.in): API key. TWOFACTOR_TEMPLATE = name of your own approved OTP template; empty
# sends 2Factor's default OTP template.
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
# Fast2SMS (fast2sms.com): API key, then EITHER an OTP template from its OTP section (FAST2SMS_OTP_ID)
# OR your DLT sender ID + the template's Message ID from DLT Manager (FAST2SMS_SENDER_ID +
# FAST2SMS_MESSAGE_ID). FAST2SMS_VARIABLES fills the template's {#var#} slots, | separated:
# {otp} = the code, {minutes} = 5. Default {otp}.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=
FAST2SMS_VARIABLES=

# Google Play review account (Play Console → App content → App access). Reviewers sign in with this
# mobile number and this fixed 6-digit code; no SMS is sent for it. Works in production. Leave both
# empty when you do not need it. Use a number that is not anyone's real account.
PLAY_REVIEW_PHONE=
PLAY_REVIEW_OTP=

# Razorpay (https://dashboard.razorpay.com → Settings → API Keys). Use test keys (rzp_test_…)
# while developing. Without them the server answers payments with 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay dashboard webhook (Settings → Webhooks). Point it at
#   https://<your-api-host>/api/payments/razorpay/webhook  and subscribe to payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Course videos on Backblaze B2 — PRIVATE bucket (free tier: 10 GB).
# Leave these empty to keep the bundled demo clips. Use a RESTRICTED application key that only
# has access to this bucket. Never put the master key here.
# B2_S3_ENDPOINT: the "Endpoint" shown on the bucket details page, with https:// in front.
B2_S3_ENDPOINT=
# B2_KEY_ID: keyID of the restricted application key (App Keys page).
B2_KEY_ID=
# B2_APPLICATION_KEY: applicationKey of that same key (shown only once, when created).
B2_APPLICATION_KEY=
# B2_BUCKET: the bucket name, exactly as created.
B2_BUCKET=

# Expo push (optional). Set this when "Enhanced push security" is on in the Expo dashboard.
EXPO_ACCESS_TOKEN=
