# Copy to .env and adjust.

# HTTP port the API listens on. The admin dashboard proxies /api here.
PORT=5000

# MongoDB connection string. Point it at any MongoDB 5+ instance.
MONGODB_URI=mongodb://127.0.0.1:27017/ydu-academy

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid (jsonwebtoken syntax: 7d, 12h, 30m...).
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins, or * for any (dev only).
CORS_ORIGIN=*

# development | production
NODE_ENV=development

# Phone sign-in (OTP). Outside production, this fixed code is accepted for any mobile number
# so the demo works without an SMS provider. Ignored when NODE_ENV=production.
DEMO_OTP=246810

# NinzaSMS OTP delivery (https://ninzasms.in.net/auth/send_sms.php). Set both keys to send real
# OTPs — the same server code path works in development and production. Find the API key on the
# dashboard's API Keys page and the sender id on the dashboard home page. The key is used
# server-side only; it never reaches the app or the browser. Leave both empty to keep the
# development fallback (code printed to the server console).
NINZA_SMS_API_KEY=
NINZA_SMS_SENDER_ID=
# Route the OTP travels on: "sms" (default) or "waninza" (WhatsApp).
NINZA_SMS_ROUTE=sms

# Razorpay (https://dashboard.razorpay.com → Settings → API Keys). Use test keys (rzp_test_…)
# while developing. Without them the server answers payments with 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay dashboard webhook (Settings → Webhooks). Point it at
#   https://<your-api-host>/api/payments/razorpay/webhook  and subscribe to payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Local server upload directory for all images and course videos.
# Leave empty to default to `<repo>/server/uploads`. Set to a mounted persistent volume in
# production (e.g. /var/data/uploads) so files survive server redeploys.
UPLOAD_DIR=
# Optional max video upload size in bytes (defaults to 4294967296 = 4 GB).
MAX_VIDEO_BYTES=

# Expo push (optional). Set this when "Enhanced push security" is on in the Expo dashboard.
EXPO_ACCESS_TOKEN=
