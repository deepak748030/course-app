# Copy to .env and adjust.

# HTTP port the API listens on. The admin dashboard proxies /api here.
PORT=5000

# MongoDB connection string. Point it at any MongoDB 5+ instance.
MONGODB_URI=mongodb://127.0.0.1:27017/ydu-academy

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid (jsonwebtoken syntax: 7d, 12h, 30m...).
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins, or * for any (dev only).
CORS_ORIGIN=*

# development | production
NODE_ENV=development

# Phone sign-in (OTP). Outside production, this fixed code is accepted for any mobile number
# so the demo works without an SMS provider. Ignored when NODE_ENV=production.
DEMO_OTP=246810

# Razorpay (https://dashboard.razorpay.com → Settings → API Keys). Use test keys (rzp_test_…)
# while developing. Without them the server answers payments with 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay dashboard webhook (Settings → Webhooks). Point it at
#   https://<your-api-host>/api/payments/razorpay/webhook  and subscribe to payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Course videos on Backblaze B2 — PRIVATE bucket (free tier: 10 GB).
# Leave these empty to keep the bundled demo clips. Use a RESTRICTED application key that only
# has access to this bucket. Never put the master key here.
# B2_S3_ENDPOINT: the "Endpoint" shown on the bucket details page, with https:// in front.
B2_S3_ENDPOINT=
# B2_KEY_ID: keyID of the restricted application key (App Keys page).
B2_KEY_ID=
# B2_APPLICATION_KEY: applicationKey of that same key (shown only once, when created).
B2_APPLICATION_KEY=
# B2_BUCKET: the bucket name, exactly as created.
B2_BUCKET=

# Lesson videos on YouTube (alternative to B2, chosen per lesson in the admin dashboard).
# Upload goes through Upload-Post (upload-post.com): sign up, create a profile, connect the
# YouTube channel there (Google login, one time), then generate an API key. Uploads are
# always UNLISTED. Leave empty to disable API upload — pasting an unlisted link in the
# dashboard and Piped playback still work without these.
UPLOAD_POST_API_KEY=
# UPLOAD_POST_PROFILE: the exact profile name on Upload-Post whose YouTube channel is connected.
UPLOAD_POST_PROFILE=
# Optional: comma-separated Piped API instances for playback, tried before the built-in list.
# Self-hosted Piped goes first, e.g. PIPED_API_BASE_URLS=https://pipedapi.example.com
PIPED_API_BASE_URLS=

# Expo push (optional). Set this when "Enhanced push security" is on in the Expo dashboard.
EXPO_ACCESS_TOKEN=
